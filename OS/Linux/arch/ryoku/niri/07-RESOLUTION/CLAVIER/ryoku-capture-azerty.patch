 // A KeyEvent as Quickshell delivers it: key code + a modifier bitmask.
 const ev = (key, ...mods) => ({ key, modifiers: mods.reduce((a, m) => a | m, 0) });
+
+test("AZERTY number row records actual XKB symbols and selects workspace families", () => {
+    const row = [
+        [0x26, "ampersand"], [0xc9, "eacute"], [0x22, "quotedbl"],
+        [0x27, "apostrophe"], [0x28, "parenleft"], [0x2d, "minus"],
+        [0xc8, "egrave"], [0x5f, "underscore"], [0xc7, "ccedilla"], [0xc0, "agrave"]
+    ];
+    for (const [key, symbol] of row) {
+        const chord = chordFrom(ev(key, Qt.MetaModifier, Qt.AltModifier));
+        assert.equal(chord, "SUPER + ALT + " + symbol);
+        assert.equal(familyFrom(chord), "SUPER + ALT + {n}");
+    }
+});
+
+test("Caps Lock digits and lowercase accented key codes remain recordable", () => {
+    for (let digit = 0; digit <= 9; digit++) {
+        const chord = chordFrom(ev(48 + digit, Qt.MetaModifier, Qt.AltModifier));
+        assert.equal(chord, "SUPER + ALT + " + digit);
+        assert.equal(familyFrom(chord), "SUPER + ALT + {n}");
+    }
+    for (const key of [0xe9, 0xe8, 0xe7, 0xe0])
+        assert.notEqual(chordFrom(ev(key, Qt.MetaModifier)), "");
+    assert.equal(familyFrom(chordFrom(ev(0x26, Qt.MetaModifier, Qt.ShiftModifier))), "SUPER + SHIFT + {n}");
+});
 
